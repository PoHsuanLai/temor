# temor's bash startup wrapper, passed with --rcfile. It runs your own startup files as bash
# would, then temor's shell integration. Nothing here writes to your home directory.
#
# bash ignores --rcfile in a login shell, so temor starts bash as a plain interactive shell and
# sets TEMOR_BASH_LOGIN when it wants a login start; this wrapper then reads the login files
# itself and runs ~/.bash_logout on exit, as a login shell would.
#
# Debian and Ubuntu build bash to read /etc/bash.bashrc before any rc file, --rcfile included,
# so it is not sourced here. In the login case their /etc/profile sources it as well, so it runs
# twice there (a real login bash would run it once); it is written to be harmless twice.

if [[ -n ${TEMOR_BASH_LOGIN-} ]]; then
    unset TEMOR_BASH_LOGIN
    [[ -r /etc/profile ]] && . /etc/profile
    for _temor_file in ~/.bash_profile ~/.bash_login ~/.profile; do
        if [[ -r $_temor_file ]]; then
            . "$_temor_file"
            break
        fi
    done
    unset _temor_file
    # A login shell runs ~/.bash_logout on exit. It goes into the EXIT trap after the person's
    # files ran, and the trap they had keeps running first. One set later at the prompt
    # replaces ours, so every prompt puts it back (see _temor_chain_exit in temor.bash).
    _temor_logout() {
        [[ -r ~/.bash_logout ]] && . ~/.bash_logout
        return 0
    }
    _temor_chain_exit() {
        local current
        current=$(trap -p EXIT)
        [[ $current == *_temor_logout* ]] && return 0
        current=${current% EXIT}
        [[ -n $current ]] && eval "current=${current#trap -- }"
        _temor_user_exit=$current
        trap '[[ -n ${_temor_user_exit-} ]] && eval "$_temor_user_exit"; _temor_logout' EXIT
    }
    _temor_chain_exit
else
    [[ -r ~/.bashrc ]] && . ~/.bashrc
fi

. "${BASH_SOURCE[0]%/*}/temor.bash"
