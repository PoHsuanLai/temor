[Desktop Entry]
Type=Application
Version=1.0
Name=temor
Comment=The desktop's terminal
Exec=temor
Icon=org.quire.Temor
Terminal=false
Categories=TerminalEmulator;System;
StartupWMClass=org.quire.Temor
StartupNotify=true
DBusActivatable=true
# keycap passes ⌘ through as Super: temor reads the keymap itself (chordkit), so ⌘D and ⌘⇧D stay apart.
X-Keycap-Profile=keymap-aware
